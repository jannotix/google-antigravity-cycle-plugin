{
  "name": "cycle-antigravity",
  "version": "1.1.1",
  "private": true,
  "description": "Evidence-gated delivery control plane for Google Antigravity",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "benchmark:500k": "node scripts/benchmark-500k.mjs --files 500000",
    "check": "npm run typecheck && npm run build && npm test && npm run validate:contract && npm run validate:plugin && node scripts/sbom.mjs --check && npm run repeat:critical && npm run package",
    "package": "node scripts/package.mjs",
    "provenance": "node scripts/provenance.mjs",
    "repeat:critical": "node scripts/repeat-critical.mjs",
    "sbom": "node scripts/sbom.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.tests.json --pretty false",
    "validate:contract": "node scripts/validate-plugin.mjs",
    "validate:plugin": "agy plugin validate ."
  },
  "keywords": [
    "antigravity",
    "antigravity-plugin",
    "code-intel",
    "delivery-governance",
    "evidence-gated",
    "tree-sitter"
  ],
  "author": "Gianluca Iannotta",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jannotix/google-antigravity-cycle-plugin.git"
  },
  "cycle": {
    "verification": {
      "excludeEcosystems": [
        "rust"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
